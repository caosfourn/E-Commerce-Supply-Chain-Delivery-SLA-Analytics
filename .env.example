# Example only. Helpers read environment variables; .env is NOT auto-loaded.
# PowerShell example: $env:OLIST_SERVER = '.\SQLEXPRESS'
OLIST_SERVER=localhost
OLIST_DATABASE=olist
OLIST_DRIVER=ODBC Driver 18 for SQL Server
OLIST_TRUST_CERTIFICATE=yes
# Optional OLIST_CONNECTION_STRING overrides server/driver/auth settings.
# Set this in your local environment; never commit a real password.
# Windows authentication is the default. Database: olist; ODBC Driver 18.
